# Copy to .env and fill in. Values come from your Supabase project settings.
#
# Leave these blank (or as-is) and the backend falls back to local storage:
# SQLite at backend/data/checkbuddy.db plus images in backend/uploads/.
# The scan flow and history both work in that mode — nothing is stubbed out.

SUPABASE_URL=
# Service role key. Backend only. Never ship this to the browser: it bypasses
# every policy, and RLS is disabled on these tables (see schema.sql).
SUPABASE_SERVICE_ROLE_KEY=
